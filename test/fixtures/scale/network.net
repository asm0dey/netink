# SCaLE expo network (full size, with APs), converted from the public scale-network repo.
# Source: https://github.com/socallinuxexpo/scale-network at commit 7d3b51dcbab48e3e3298a48c087af5cdf94d1a8c
#   switch-configuration/config/{vlans,vlans.d/*,booth_list.tsv,switchtypes,trunktypes,types/*},
#   facts/routers/routerlist.csv, facts/aps/apuse.csv
# Retrieved 2026-11-14. Licence: BSD-3-Clause (see LICENSE beside this file).
# Converted by a throwaway script; this file is the source of truth.
#
# Mapping (what is published vs inferred):
# - VLANs: every VLAN line in vlans.d/{Expo,Conference,Bridged} with its IPv4/IPv6 prefix and
#   background colour; 0.0.0.0/0 and ::/0 (IPv6-only, transit) are left out. Hilton VLANs are
#   commented out upstream and skipped. Vendor VLANs (VVRNG 200-498): one per booth_list.tsv
#   booth, numbered in file order, prefixes from switch_template.pm's VV_get_prefix4/6.
#   Upstream allocates 16 per booth switch at build time; this per-booth numbering is an
#   approximation. Vendor VLANs are access ports on booth switches and ride no trunk here.
# - Trunks: one trunk set per trunktypes entry. Every link uses the child's ge-0/0/0 trunk type.
# - Switches: every switchtypes row, model from it. Hierarchy column gives the tree (level n
#   hangs off the deepest lower level of its group); Z (unused) switches are left unlinked.
#   Inferred, not published: group heads C.1, F.1 and W.1 hang off ExpoIDF (X.1); X.1 and I.1
#   uplink to ex-mdf-01 and cf-mdf-01.
# - APs: every apuse.csv row, attached by name (room number, ballroom, booth switch, AV, NOC,
#   reghall -> RegDesk), else to the building IDF by IPv4 (10.0.x Expo, 10.128.x Conference).
#   Expo APs use trunk exAP, Conference APs cfAP. The attachment is inferred.
# - Routers: routerlist.csv names. Router-to-router links, port names and the COGENT uplink are
#   inferred; gateway addresses follow the routerlist ::1 convention (.1 / ::1 per routed VLAN,
#   .2 / ::2 for the downstream end of a router link). Switch management addresses are dropped.
# - Rewrites: ids are the names lowercased; labels keep the original names.
title "SCaLE expo network"
subtitle "socallinuxexpo/scale-network, full size"

# VLANs
# 2.4G Wireless Network in Expo Center
vlan exw-SLOW 100 color "#0088ac" subnet 10.0.128.0/21, 2001:470:f026:100::/64
# 5G Wireless Network in Expo Center
vlan exw-FAST 101 color "#044c84" subnet 10.0.136.0/21, 2001:470:f026:101::/64
# Speaker Network
vlan exSpkr 102 color "#eeddbb" subnet 10.0.2.0/24, 2001:470:f026:102::/64
# SCALE NetInfra + Servers (Expo Center)
vlan exInfra 103 color "#cbf8cb" subnet 10.0.3.0/24, 2001:470:f026:103::/64
# Link to MDF Router
vlan exMDF 104 color "#ffff00" subnet 10.0.4.0/24, 2001:470:f026:104::/64
# AV Network (DHCP Relay to AV server)
vlan exAV 105 color "#ff4f00" subnet 10.0.5.0/24, 2001:470:f026:105::/64
# Signs network (Expo Center) IPv6 Only
vlan exSigns 107 color "#604040" subnet 2001:470:f026:107::/64
# Registration Network (Expo Center)
vlan exReg 110 color "#9abfca" subnet 10.0.10.0/24, 2001:470:f026:110::/64
# Special network for VM Vending Machine
vlan exVmVndr 112 color "#0000ff" subnet 10.0.144.0/20, 2001:470:f026:112::/64
# Vendor Backbone
vlan vendor_backbone 499 color "#aa3a0a" subnet 10.1.0.0/24, 2001:470:f026:499::/64
# 2.4G Wireless Network in Conference Center
vlan cfw-SLOW 500 color "#0088ac" subnet 10.128.128.0/21, 2001:470:f026:500::/64
# 5G Wireless Network in Conference Center
vlan cfw-FAST 501 color "#044c84" subnet 10.128.136.0/21, 2001:470:f026:501::/64
# Speaker Network
vlan cfSpkr 502 color "#eeddbb" subnet 10.128.2.0/24, 2001:470:f026:502::/64
# SCALE Net Infra and Servers (Conference Center)
vlan cfInfra 503 color "#cbf8cb" subnet 10.128.3.0/24, 2001:470:f026:503::/64
# Capture the Flag
vlan cfCTF 504 color "#000000" subnet 10.128.4.0/24, 2001:470:f026:504::/64
# Audio Visual Network (DHCP Helper to AV server)
vlan cfAV 505 color "#ff4f00" subnet 10.128.5.0/24, 2001:470:f026:505::/64
# Wired network in NOC
vlan cfNOC 506 color "#f6d669" subnet 10.128.6.0/24, 2001:470:f026:506::/64
# Signs network (Conference Center) IPv6 Only
vlan cfSigns 507 color "#604040" subnet 2001:470:f026:507::/64
# Install Fests and Workshops
vlan cfInstl 510 color "#f28fd3" subnet 10.128.10.0/24, 2001:470:f026:510::/64
# Link between IDF in Conference and Expo Centers
vlan MDF_LINK 900 color "#ffff00" subnet 172.20.0.0/24, 2001:470:f026:8000::/64
# COGENT IPv4 Transit Link (PSAV & PCC)
vlan COGENT 999 color "#c0ff00" subnet 38.98.46.128/25

# Vendor VLANs, one per booth
