# Links (cables)
link dmi01-akron-rtr01.GigabitEthernet0/1/0 -- dmi01-akron-sw01.GigabitEthernet1/0/1 trunk dm-akron
link dmi01-akron-rtr01.GigabitEthernet0/1/1 -- dmi01-akron-sw01.GigabitEthernet1/0/2 trunk dm-akron
link dmi01-albany-rtr01.GigabitEthernet0/1/0 -- dmi01-albany-sw01.GigabitEthernet1/0/1 trunk dm-albany
link dmi01-albany-rtr01.GigabitEthernet0/1/1 -- dmi01-albany-sw01.GigabitEthernet1/0/2 trunk dm-albany
link dmi01-binghamton-rtr01.GigabitEthernet0/1/0 -- dmi01-binghamton-sw01.GigabitEthernet1/0/1 trunk dm-binghamton
link dmi01-binghamton-rtr01.GigabitEthernet0/1/1 -- dmi01-binghamton-sw01.GigabitEthernet1/0/2 trunk dm-binghamton
