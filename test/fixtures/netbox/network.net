# NetBox demo data (v4.7), converted from the public netbox-demo-data repo.
# Source: https://github.com/netbox-community/netbox-demo-data at commit faeae5904a29ce6ad519a3de270ca218a7b050f9, sql/netbox-demo-v4.7.sql
# Retrieved 2026-11-14. Licence: MIT (see LICENSE beside this file).
# Converted by a throwaway script; this file is the source of truth.
#
# Mapping:
# - Devices: the 26 devices that end at least one interface-to-interface cable; power,
#   console, front/rear-port (patch panel) and circuit cables are not links. Kind = device role,
#   model = device type. Ports are the cabled interfaces, names as in NetBox.
# - Links: one per interface-to-interface cable, port to port. The dump assigns no VLANs to any
#   interface (no mode, no tagged/untagged VLANs). Inferred: each site's router-to-switch cables
#   carry that site's VLANs, as one trunk set per site named by the site slug.
# - Routers (role router) get `router`, a `wan` line per interface cabled to a circuit, and an
#   `address` line per IP assigned to an interface. The dump assigns none of its
#   180 IP addresses to an interface (180 unassigned), so there are no address lines.
# - VLANs: those of the 13 sites with drawn devices (39 of 63); the rest belong to sites
#   with no interface-to-interface cable, so no link could carry them.
#   Names clash across sites (Data, Voice, Wireless), so each clashing
#   name is suffixed with its VLAN group slug, or its site slug when it has no group.
# - Prefixes: the 39 tied to a VLAN are that VLAN's subnet. The 51 tied to no VLAN have no
#   place in the DSL and are listed below as comments.
# - Rewrites: none needed (no port name has a character the DSL rejects).
#
# Prefixes without a VLAN (scope: prefix [description]):
#   global: 10.112.0.0/17 [DM HQ]
#   global: 10.112.0.0/15
#   global: 10.112.128.0/17 [DM branch offices]
#   global: 192.168.0.0/22
#   global: 172.16.0.0/24
#   global: 172.16.1.0/24
#   global: 172.16.0.0/16
#   global: 172.16.2.0/24
#   global: 172.17.0.0/24
#   global: 172.17.1.0/24
#   global: 172.17.0.0/16
#   global: 172.17.2.0/24
#   global: 172.18.0.0/24
#   global: 172.18.1.0/24
#   global: 172.18.0.0/16
#   global: 172.18.2.0/24
#   global: 172.19.0.0/24
#   global: 172.19.1.0/24
#   global: 172.19.0.0/16
#   global: 172.19.2.0/24
#   global: 172.20.0.0/24
#   global: 172.20.1.0/24
#   global: 172.20.0.0/16
#   global: 172.20.2.0/24
#   global: 192.168.0.0/20 [Shared services]
#   dm-akron: 10.112.128.0/28
#   dm-akron: 10.112.128.0/22
#   dm-albany: 10.112.132.0/28
#   dm-albany: 10.112.132.0/22
#   dm-binghamton: 10.112.136.0/28
#   dm-binghamton: 10.112.136.0/22
#   dm-buffalo: 10.112.140.0/28
#   dm-buffalo: 10.112.140.0/22
#   dm-camden: 10.112.144.0/28
#   dm-camden: 10.112.144.0/22
#   dm-nashua: 10.112.148.0/28
#   dm-nashua: 10.112.148.0/22
#   dm-pittsfield: 10.112.152.0/28
#   dm-pittsfield: 10.112.152.0/22
#   dm-rochester: 10.112.156.0/28
#   dm-rochester: 10.112.156.0/22
#   dm-scranton: 10.112.160.0/28
#   dm-scranton: 10.112.160.0/22
#   dm-stamford: 10.112.164.0/28
#   dm-stamford: 10.112.164.0/22
#   dm-syracuse: 10.112.168.0/28
#   dm-syracuse: 10.112.168.0/22
#   dm-utica: 10.112.172.0/28
#   dm-utica: 10.112.172.0/22
#   dm-yonkers: 10.112.176.0/28
#   dm-yonkers: 10.112.176.0/22
title "NetBox demo data"
subtitle "netbox-community/netbox-demo-data v4.7"

# VLANs
vlan Data-dm-akron 100 subnet 10.112.129.0/24
vlan Voice-dm-akron 200 subnet 10.112.130.0/24
vlan Data-dm-albany 100 subnet 10.112.133.0/24
vlan Voice-dm-albany 200 subnet 10.112.134.0/24
vlan Data-dm-binghamton 100 subnet 10.112.137.0/24
vlan Voice-dm-binghamton 200 subnet 10.112.138.0/24
vlan Data-dm-buffalo 100 subnet 10.112.141.0/24
vlan Voice-dm-buffalo 200 subnet 10.112.142.0/24
vlan Data-dm-camden 100 subnet 10.112.145.0/24
vlan Voice-dm-camden 200 subnet 10.112.146.0/24
vlan Data-dm-nashua 100 subnet 10.112.149.0/24
vlan Voice-dm-nashua 200 subnet 10.112.150.0/24
vlan Data-dm-pittsfield 100 subnet 10.112.153.0/24
vlan Voice-dm-pittsfield 200 subnet 10.112.154.0/24
vlan Data-dm-rochester 100 subnet 10.112.157.0/24
vlan Voice-dm-rochester 200 subnet 10.112.158.0/24
vlan Data-dm-scranton 100 subnet 10.112.161.0/24
vlan Voice-dm-scranton 200 subnet 10.112.162.0/24
vlan Data-dm-stamford 100 subnet 10.112.165.0/24
vlan Voice-dm-stamford 200 subnet 10.112.166.0/24
vlan Data-dm-syracuse 100 subnet 10.112.169.0/24
vlan Voice-dm-syracuse 200 subnet 10.112.170.0/24
vlan Data-dm-utica 100 subnet 10.112.173.0/24
vlan Voice-dm-utica 200 subnet 10.112.174.0/24
vlan Data-dm-yonkers 100 subnet 10.112.177.0/24
vlan Voice-dm-yonkers 200 subnet 10.112.178.0/24
vlan Wireless-dm-akron 300 subnet 10.112.131.0/24
vlan Wireless-dm-albany 300 subnet 10.112.135.0/24
vlan Wireless-dm-binghamton 300 subnet 10.112.139.0/24
vlan Wireless-dm-buffalo 300 subnet 10.112.143.0/24
vlan Wireless-dm-camden 300 subnet 10.112.147.0/24
vlan Wireless-dm-nashua 300 subnet 10.112.151.0/24
vlan Wireless-dm-pittsfield 300 subnet 10.112.155.0/24
vlan Wireless-dm-rochester 300 subnet 10.112.159.0/24
vlan Wireless-dm-scranton 300 subnet 10.112.163.0/24
vlan Wireless-dm-stamford 300 subnet 10.112.167.0/24
vlan Wireless-dm-syracuse 300 subnet 10.112.171.0/24
vlan Wireless-dm-utica 300 subnet 10.112.175.0/24
vlan Wireless-dm-yonkers 300 subnet 10.112.179.0/24

# Trunk sets: each site's VLANs
trunk dm-akron vlans Data-dm-akron, Voice-dm-akron, Wireless-dm-akron
trunk dm-albany vlans Data-dm-albany, Voice-dm-albany, Wireless-dm-albany
trunk dm-binghamton vlans Data-dm-binghamton, Voice-dm-binghamton, Wireless-dm-binghamton
trunk dm-buffalo vlans Data-dm-buffalo, Voice-dm-buffalo, Wireless-dm-buffalo
trunk dm-camden vlans Data-dm-camden, Voice-dm-camden, Wireless-dm-camden
trunk dm-nashua vlans Data-dm-nashua, Voice-dm-nashua, Wireless-dm-nashua
trunk dm-pittsfield vlans Data-dm-pittsfield, Voice-dm-pittsfield, Wireless-dm-pittsfield
trunk dm-rochester vlans Data-dm-rochester, Voice-dm-rochester, Wireless-dm-rochester
trunk dm-scranton vlans Data-dm-scranton, Voice-dm-scranton, Wireless-dm-scranton
trunk dm-stamford vlans Data-dm-stamford, Voice-dm-stamford, Wireless-dm-stamford
trunk dm-syracuse vlans Data-dm-syracuse, Voice-dm-syracuse, Wireless-dm-syracuse
trunk dm-utica vlans Data-dm-utica, Voice-dm-utica, Wireless-dm-utica
trunk dm-yonkers vlans Data-dm-yonkers, Voice-dm-yonkers, Wireless-dm-yonkers

# Site DM-Akron (dm-akron)
device dmi01-akron-rtr01 kind router model "ISR 1111-8P"
  wan GigabitEthernet0/0/0
  wan GigabitEthernet0/0/1
  router
  ports GigabitEthernet0/1/0, GigabitEthernet0/1/1
device dmi01-akron-sw01 kind access-switch model "C9200-48P"
  ports GigabitEthernet1/0/1, GigabitEthernet1/0/2

# Site DM-Albany (dm-albany)
device dmi01-albany-rtr01 kind router model "ISR 1111-8P"
  wan GigabitEthernet0/0/0
  wan GigabitEthernet0/0/1
  router
  ports GigabitEthernet0/1/0, GigabitEthernet0/1/1
device dmi01-albany-sw01 kind access-switch model "C9200-48P"
  ports GigabitEthernet1/0/1, GigabitEthernet1/0/2

